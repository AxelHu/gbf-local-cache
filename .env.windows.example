# Copy this file to .env.windows for native Windows deployment.
# Paths use normal Windows syntax; no WSL paths are required.

# Fast writable primary cache. %LOCALAPPDATA% is expanded by the PowerShell
# launcher. Override this if you want the cache on another local SSD.
GBF_CACHE_ROOT="%LOCALAPPDATA%\GBFLocalCache\cache\gbf"

# Optional read-only ACGPower cache roots, separated by semicolons.
# These are examples only. Set this to an empty string if there is no old
# ACGPower cache on this machine.
GBF_LEGACY_CACHE_ROOTS="F:\Programs\acgpower-x64\cache\gbf;F:\Programs\acgpower\cache\gbf"

# A verified primary object is served without revalidation for this many
# seconds. 21600 = 6 hours.
GBF_CACHE_FRESH_SECONDS=21600

# Local forward proxy and PAC server ports.
GBF_CACHE_PROXY_PORT=18123
GBF_CACHE_PAC_PORT=18124

# Optional HTTP CONNECT proxy used only for CDN cache misses/revalidation.
# Example: GBF_UPSTREAM_PROXY="http://127.0.0.1:1080"
GBF_UPSTREAM_PROXY=""

# Runtime state (logs, generated mitmproxy CA, PID file).
GBF_WINDOWS_STATE_ROOT="%LOCALAPPDATA%\GBFLocalCache"

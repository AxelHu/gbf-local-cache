# Copy this file to .env and edit it for the target machine.
# start.sh/run.sh/status.sh/stop.sh all load .env automatically.

# Fast writable primary cache. Keeping this on WSL/ext4 is recommended because
# GBF produces many small files.
GBF_CACHE_ROOT="$HOME/.cache/gbf-local-cache/gbf"

# Optional read-only ACGPower cache roots, separated by semicolons.
# These paths are examples only. Set this to an empty string if the target
# machine has no legacy ACGPower cache.
GBF_LEGACY_CACHE_ROOTS="/mnt/f/Programs/acgpower-x64/cache/gbf;/mnt/f/Programs/acgpower/cache/gbf"

# A verified primary object is served without revalidation for this many
# seconds. 21600 = 6 hours.
GBF_CACHE_FRESH_SECONDS=21600

# Local forward proxy and PAC server ports.
GBF_CACHE_PROXY_PORT=18123
GBF_CACHE_PAC_PORT=18124

# Optional HTTP CONNECT proxy used only for CDN cache misses/revalidation.
# Leave empty for direct CDN access.
GBF_UPSTREAM_PROXY=""
